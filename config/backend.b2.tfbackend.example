bucket               = "replace-with-private-b2-bucket-name"
region               = "replace-with-b2-region"
key                  = "github-app-governance/replace-with-your-organization/terraform.tfstate"
workspace_key_prefix = "github-app-governance/replace-with-your-organization/workspaces"

endpoints = {
  s3 = "https://s3.replace-with-b2-region.backblazeb2.com"
}

encrypt                     = true
use_lockfile                = false
use_path_style              = true
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
